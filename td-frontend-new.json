{
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "745854319016.dkr.ecr.eu-west-1.amazonaws.com/cts-dashboard-frontend:20251010-151147",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "name": "frontend-80-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "command": [
        "nginx",
        "-g",
        "daemon off;"
      ],
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/cts-dashboard-frontend",
          "awslogs-create-group": "true",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -fsS http://localhost/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3
      },
      "systemControls": []
    }
  ],
  "family": "cts-dashboard-frontend",
  "executionRoleArn": "arn:aws:iam::745854319016:role/ecsTaskExecutionRole-cts-dashboard",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "2048",
  "enableFaultInjection": false
}
